NODE_ENV=production
PORT=3003

# ── Clients ──────────────────────────────────────────────────────────────
# Each client is one numbered group: CLIENT_1_*, CLIENT_2_*, CLIENT_3_*, ...
# Clients are auto-discovered — add another numbered block and restart, no code
# change needed. A group with no _SLUG is ignored, so a half-filled client can
# never crash startup. The webhook URL for a client is:
#   https://capi.studio-hogo.com/webhooks/<CLIENT_n_SLUG>/order-paid
#
# (Legacy var names — CLIENT_SLUG + unprefixed, and CLIENT_TWO_*/CLIENT_THREE_*
#  — are still honored for backward compatibility, but new clients should use
#  the numbered convention below.)

# --- Client 1 ---
CLIENT_1_SLUG=client-one
CLIENT_1_SHOPIFY_WEBHOOK_SECRET=your_shopify_signing_secret_here
CLIENT_1_META_PIXEL_ID=your_pixel_id_here
CLIENT_1_META_CAPI_TOKEN=your_capi_access_token_here
CLIENT_1_META_TEST_EVENT_CODE=TEST12345
CLIENT_1_STORE_URL=https://client-one.myshopify.com
CLIENT_1_SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_1_SHOPIFY_STORE_DOMAIN=client-one.myshopify.com

# --- Client 2 ---
CLIENT_2_SLUG=client-two
CLIENT_2_SHOPIFY_WEBHOOK_SECRET=your_shopify_signing_secret_here
CLIENT_2_META_PIXEL_ID=your_pixel_id_here
CLIENT_2_META_CAPI_TOKEN=your_capi_access_token_here
CLIENT_2_META_TEST_EVENT_CODE=TEST12345
CLIENT_2_STORE_URL=https://client-two.myshopify.com
CLIENT_2_SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_2_SHOPIFY_STORE_DOMAIN=client-two.myshopify.com

# --- Client 3 ---
CLIENT_3_SLUG=client-three
CLIENT_3_SHOPIFY_WEBHOOK_SECRET=your_shopify_signing_secret_here
CLIENT_3_META_PIXEL_ID=your_pixel_id_here
CLIENT_3_META_CAPI_TOKEN=your_capi_access_token_here
CLIENT_3_META_TEST_EVENT_CODE=TEST12345
CLIENT_3_STORE_URL=https://client-three.myshopify.com
CLIENT_3_SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_3_SHOPIFY_STORE_DOMAIN=client-three.myshopify.com
